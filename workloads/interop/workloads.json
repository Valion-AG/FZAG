          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "args": [
                  "/opt/kafka/bin/kafka-storage.sh format --ignore-formatted --cluster-id \"$(cat /etc/kafka-poc/cluster-id)\" --config /etc/kafka-poc/server.properties\nexec /opt/kafka/bin/kafka-server-start.sh /etc/kafka-poc/server.properties\n"
                ],
                "command": [
                  "/bin/bash",
                  "-ec"
                ],
                "env": [
                  {
                    "name": "KAFKA_HEAP_OPTS",
                    "value": "-Xms256m -Xmx512m"
                  },
                  {
                    "name": "KAFKA_LOG4J_OPTS",
                    "value": "-Dlog4j2.configurationFile=/opt/kafka/config/log4j2.yaml"
                  }
                ],
                "image": "fzaginterop261019.azurecr.io/kafka@sha256:77e3df9054047a88b520d0cc46e16696d3b22022e1d580aeccd2632df6532837",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "failureThreshold": 6,
                  "periodSeconds": 20,
                  "successThreshold": 1,
                  "tcpSocket": {
                    "port": "internal"
                  },
                  "timeoutSeconds": 1
                },
                "name": "kafka",
                "ports": [
                  {
                    "containerPort": 9092,
                    "name": "internal",
                    "protocol": "TCP"
                  },
                  {
                    "containerPort": 9093,
                    "hostPort": 9093,
                    "name": "external",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "periodSeconds": 10,
                  "successThreshold": 1,
                  "tcpSocket": {
                    "port": "internal"
                  },
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "cpu": "1",
                    "memory": "1280Mi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "memory": "768Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "startupProbe": {
                  "failureThreshold": 60,
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "tcpSocket": {
                    "port": "internal"
                  },
                  "timeoutSeconds": 1
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/data",
                    "name": "data"
                  },
                  {
                    "mountPath": "/etc/kafka-poc",
                    "name": "config",
                    "readOnly": true
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "imagePullSecrets": [
              {
                "name": "acr-pull"
              }
            ],
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {
              "fsGroup": 1000,
              "runAsGroup": 1000,
              "runAsUser": 1000
            },
            "terminationGracePeriodSeconds": 30,
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "kafka-data"
                }
              },
              {
                "name": "config",
                "secret": {
                  "defaultMode": 288,
                  "secretName": "kafka-config"
                }
              }
            ]
          }
        },
        "updateStrategy": {
          "rollingUpdate": {
            "partition": 0
          },
          "type": "RollingUpdate"
        }
